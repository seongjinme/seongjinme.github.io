---
import SocialLinks from '@/components/SocialLinks.astro';
import { ui, type Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="profile">
  <p>{ui[locale].profileIntro}</p>
  <p>{ui[locale].profileBody}</p>
  <SocialLinks />
</div>
