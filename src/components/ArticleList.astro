---
import type { CollectionEntry } from 'astro:content';

interface Props {
  articles: CollectionEntry<'articles'>[];
}

const { articles } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString('ko-KR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Asia/Seoul',
  });
---

<ul class="article-list">
  {articles.map((article) => (
    <li class="article-item">
      <a class="article-item-container" href={`/${article.id}/`}>
        <div class="article-content">
          <h3 class="article-title">{article.data.title}</h3>
          <span class="article-description">{article.data.description}</span>
          <span class="article-meta">{formatDate(article.data.pubDate)}</span>
        </div>
      </a>
    </li>
  ))}
</ul>
